{
  "name": "cat-fishing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "dev": "tsx --watch src/index.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "unregister-commands": "tsx src/util/unregister-commands.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:ui": "drizzle-kit studio"
  },
  "dependencies": {
    "@discordjs/core": "^2.3.0",
    "@libsql/client": "^0.17.3",
    "@t3-oss/env-core": "^0.13.11",
    "discord.js": "^14.24.0",
    "drizzle-orm": "^1.0.0-rc.3",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/node": "^25.9.1",
    "drizzle-kit": "1.0.0-rc.3",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "pino-pretty": "^13.1.3",
    "rolldown": "^1.0.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
