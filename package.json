  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/node": "^22.18.8",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "pino-pretty": "^13.1.3",
    "rolldown": "^1.0.3",
    "tsx": "^4.22.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.7",
    "zod": "^3.25.76"
